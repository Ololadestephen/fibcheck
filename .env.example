# Copy this file to .env and fill in the values. Never commit .env.

# Google Gemini API key for Pinocchio's own agent.
# Create it at https://aistudio.google.com/apikey
# On the free tier, Google may use what is sent to improve its products.
# Pinocchio only sends public README text, Kane results and public code.
GEMINI_API_KEY=

# Optional: model names (defaults: gemini-3.6-flash, then gemini-3.5-flash-lite on rate limits or server timeouts).
PINOCCHIO_GEMINI_MODEL=
PINOCCHIO_GEMINI_FALLBACK_MODEL=

# Optional: model call limits (defaults: 60 per run, 1500 in total).
PINOCCHIO_MAX_CALLS_PER_RUN=
PINOCCHIO_MAX_CALLS_TOTAL=

# Kane CLI logs in with `kane-cli login`, so no key is needed here.
# For CI only, Kane accepts basic auth:
LT_USERNAME=
LT_ACCESS_KEY=
