# Copy this file to .env and fill in the values. Never commit .env.

# Model provider for Pinocchio's own agent (decided in approval A2).
ANTHROPIC_API_KEY=

# Spending caps in US dollars.
PINOCCHIO_MAX_USD_PER_RUN=
PINOCCHIO_MAX_USD_TOTAL=

# Kane CLI logs in with `kane-cli login`, so no key is needed here.
# For CI only, Kane accepts basic auth:
LT_USERNAME=
LT_ACCESS_KEY=
