# Copy this file to .env and fill in the values. Never commit .env.

# Google Gemini API key for fibcheck's own agent.
# Create it at https://aistudio.google.com/apikey
# On the free tier, Google may use what is sent to improve its products.
# fibcheck only sends public README text, Kane results and public code.
GEMINI_API_KEY=

# Optional: model names (defaults: gemini-3.5-flash-lite for both on rate limits or server timeouts).
FIBCHECK_GEMINI_MODEL=
FIBCHECK_GEMINI_FALLBACK_MODEL=

# Optional: model call limits (defaults: 60 per run, 1500 in total).
FIBCHECK_MAX_CALLS_PER_RUN=
FIBCHECK_MAX_CALLS_TOTAL=

# Kane CLI logs in with `kane-cli login`, so no key is needed here.
# For CI only, Kane accepts basic auth:
LT_USERNAME=
LT_ACCESS_KEY=

# Optional paid backup on NEAR AI Cloud, used only when Gemini's free tier refuses or is overloaded.
# Capped at $0.20 in total (kept in .fibcheck/near-spend.json). Sends the same public data as Gemini.
NEAR_AI_API_KEY=
