{
  "name": "fibcheck",
  "version": "0.0.0",
  "private": true,
  "description": "Finds the false claims in a web app's README with Kane CLI, and proves the fix.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "files": ["dist/", "targets/linkding.json"],
  "bin": {
    "fibcheck": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@google/genai": "^3.3.0"
  }
}
