{
  "name": "fibcheck",
  "version": "0.1.2",
  "description": "A lie detector for READMEs and docs: checks each claim in a real browser with Kane CLI, and proves the fix.",
  "keywords": [
    "documentation",
    "readme",
    "docs",
    "testing",
    "browser-testing",
    "kane-cli",
    "github-action"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ololadestephen/fibcheck.git"
  },
  "homepage": "https://github.com/Ololadestephen/fibcheck#readme",
  "bugs": {
    "url": "https://github.com/Ololadestephen/fibcheck/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist/",
    "targets/linkding.json",
    "CHANGELOG.md"
  ],
  "bin": {
    "fibcheck": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir src"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@google/genai": "^3.3.0"
  }
}
